# Handles PIN verification and runs the manager sub-menu.
def handle_manager_menu(members, menu):
    pin = input("Enter manager PIN: ").strip()
    if pin != MANAGER_PIN:
        print("Incorrect PIN. Access denied.")
        return

    while True:
        print("\n---------- MANAGER OPTIONS ----------")
        print("1. View daily sales report")
        print("2. Register loyalty member")
        print("3. View loyalty members")
        print("0. Return to main menu")
        print("-------------------------------------")

        choice = get_menu_choice(0, 3)
        if choice == 1:
            orders = load_orders(ORDERS_FILE)
            report = generate_daily_report(orders, menu)
            display_report(report)
        elif choice == 2:
            register_member(members)
            save_loyalty(LOYALTY_FILE, members)
        elif choice == 3:
            display_loyalty_members(members)
        elif choice == 0:
            break

# Prompts for customer type (student, staff, or regular) for discounts.
def get_customer_type():
    print("\nCustomer Type:")
    print("1. Regular (No ID discount)")
    print("2. Student (10% discount with valid ID)")
    print("3. Staff (5% discount with valid ID)")
    choice = get_menu_choice(1, 3)
    if choice == 2:
        return "student"
    elif choice == 3:
        return "staff"
    return "regular"

   # Processes customer discounts, loyalty points, receipt printing, and saving.
def handle_checkout(order, menu, members):
    if not order:
        print("\nCannot checkout. Your order is empty.")
        return False

    customer_type = get_customer_type()
    totals = calculate_total(order, menu, customer_type)

    member_id = None
    free_coffee = False

    if get_yes_no("Is the customer a loyalty member? (y/n): "):
        entered_id = input("Enter Member ID (e.g., M001): ").strip().upper()
        if entered_id in members:
            member_id = entered_id
            pts = members[member_id]["points"]
            print(f"Welcome back, {members[member_id]['name']}! Current points: {pts}")
            if pts >= 50:
                if get_yes_no("You have 50+ points! Redeem 50 points for a free Regular Coffee? (y/n): "):
                    if redeem_points(members, member_id, order):
                        free_coffee = True
                        print("50 points redeemed! Free Regular Coffee added.")
        else:
            print("Member ID not found. Proceeding without loyalty account.")

    # Print receipt (exclude FREE_C01 from paid items list since print_receipt handles it)
    paid_order = {k: v for k, v in order.items() if k != "FREE_C01"}
    print_receipt(paid_order, menu, totals, customer_type, free_coffee)

    # Award points based on final total spent
    if member_id:
        earned = award_points(members, member_id, totals[3])
        save_loyalty(LOYALTY_FILE, members)
        print(f"Loyalty points earned: {earned} | New balance: {members[member_id]['points']} pts")

    save_order(ORDERS_FILE, order, totals)
    order.clear()
    return True


