# Prompts until the user enters a valid menu number in range
def get_menu_choice(min_option, max_option):
    while True:
        try:
            choice = int(input(f"Enter your choice ({min_option}-{max_option}): "))
            if min_option <= choice <= max_option:
                return choice
            else:
                print(f"Invalid choice. Please enter a number from {min_option} to {max_option}.")
        except ValueError:
            print("Invalid input. Please enter a whole number.")

# Adds an item to the order or updates its quantity
def add_item(order, menu, code, quantity=1):
    code = code.upper()
    if code in menu:
        if code in order:
            order[code] += quantity
        else:
            order[code] = quantity
    return order

# Removes an item from the order if it exists
def remove_item(order, code):
    code = code.upper()
    if code in order:
        order.pop(code)
        return True
    return False

