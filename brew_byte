# Calculates and returns the subtotal of the order
def calculate_subtotal(order, menu):
    subtotal = 0.0
    for code, quantity in order.items():
        if code in menu:
            price = menu[code][2]
            subtotal += quantity * price
    return subtotal

# Calculates student/staff ID discount and bulk order discount
def calculate_discount(subtotal, customer_type):
    discount = 0.0
    c_type = customer_type.lower()

    if c_type == "student":
        discount += subtotal * 0.10
    elif c_type == "staff":
        discount += subtotal * 0.05

    if subtotal >= 2500:
        discount += 200.0

    # Ensure discount never exceeds subtotal
    if discount > subtotal:
        discount = subtotal

    return discount

# Calculates GCT tax on the given amount
def calculate_tax(amount, rate=GCT_RATE):
    return amount * rate

# Calculates subtotal, discount, tax, and final total
def calculate_total(order, menu, customer_type):
    subtotal = calculate_subtotal(order, menu)
    discount = calculate_discount(subtotal, customer_type)
    taxable_amount = subtotal - discount
    tax = calculate_tax(taxable_amount, GCT_RATE)
    total = taxable_amount + tax
    return (subtotal, discount, tax, total)

# Prompts until the user enters a valid quantity between 1 and 20
def get_valid_quantity(prompt):
    while True:
        try:
            qty = int(input(prompt))
            if 1 <= qty <= 20:
                return qty
            else:
                print("Invalid quantity. Please enter a number from 1 to 20.")
        except ValueError:
            print("Invalid input. Please enter a whole number.")

# Prompts until the user enters an item code that exists in the menu
def get_valid_code(prompt, menu):
    while True:
        code = input(prompt).strip().upper()
        if code in menu:
            return code
        print("Item code not found. Please try again.")

# Prompts until the user enters y/yes or n/no
def get_yes_no(prompt):
    while True:
        answer = input(prompt).strip().lower()
        if answer in ("y", "yes"):
            return True
        elif answer in ("n", "no"):
            return False
        else:
            print("Invalid input. Please enter 'y' or 'n'.")

# Prints a formatted receipt showing all items and final totals
def print_receipt(order, menu, totals, customer_type, free_coffee=False):
    subtotal, discount, tax, total = totals

    print("\n" + "=" * 46)
    print(f"{'BREW & BYTE CAFÉ':^46}")
    print("=" * 46)

    for code, quantity in order.items():
        name = menu[code][0]
        price = menu[code][2]
        line_total = quantity * price
        print(f"{name:<24} x{quantity:<3} ${line_total:>11,.2f} JMD")

    if free_coffee:
        print(f"{'Regular Coffee (Reward)':<24} x1   ${0.00:>11,.2f} JMD")

    print("-" * 46)
    print(f"{'Subtotal':<28} ${subtotal:>11,.2f} JMD")

    # Build discount label
    labels = []
    if customer_type.lower() in ("student", "staff"):
        labels.append(customer_type.lower())
    if subtotal >= 2500:
        labels.append("bulk")
    disc_label = f"Discount ({' + '.join(labels)})" if labels else "Discount"

    print(f"{disc_label:<28}-${discount:>11,.2f} JMD")
    print(f"{'GCT (15%)':<28} ${tax:>11,.2f} JMD")
    print(f"{'TOTAL':<28} ${total:>11,.2f} JMD")
    print("=" * 46)
    print(f"{'Thank you for visiting Brew & Byte Café!':^46}")
    print("=" * 46)


