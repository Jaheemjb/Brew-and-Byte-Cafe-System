# Reads the menu from a text file or loads the default menu if missing
def load_menu(filename):
    if not os.path.exists(filename):
        print(f"Warning: '{filename}' not found. Loading default menu.")
        return get_menu()

    menu = {}
    try:
        with open(filename, "r", encoding="utf-8") as file:
            for line in file:
                line = line.strip()
                if not line:
                    continue
                parts = line.split(",")
                if len(parts) != 4:
                    continue
                code = parts[0].strip().upper()
                name = parts[1].strip()
                category = parts[2].strip()
                price = float(parts[3].strip())
                menu[code] = (name, category, price)
    except (OSError, ValueError):
        print(f"Warning: Error reading '{filename}'. Loading default menu.")
        return get_menu()

    if not menu:
        print(f"Warning: '{filename}' is empty or invalid. Loading default menu.")
        return get_menu()

    return menu

# Reads loyalty members from a file into a dictionary
def load_loyalty(filename):
    members = {}
    if not os.path.exists(filename):
        return members

    try:
        with open(filename, "r", encoding="utf-8") as file:
            for line in file:
                line = line.strip()
                if not line:
                    continue
                parts = line.split(",")
                if len(parts) != 3:
                    continue
                member_id = parts[0].strip().upper()
                name = parts[1].strip()
                points = int(parts[2].strip())
                members[member_id] = {"name": name, "points": points}
    except (OSError, ValueError):
        print("Warning: Could not read loyalty file properly.")
    return members

# Writes the loyalty members dictionary to a file
def save_loyalty(filename, members):
    try:
        with open(filename, "w", encoding="utf-8") as file:
            for member_id, info in members.items():
                file.write(f"{member_id},{info['name']},{info['points']}\n")
    except OSError:
        print("Error: Could not save loyalty data.")

 #Registers a new loyalty member with a unique ID and 0 points.
 # Generate a unique ID like M001, M002, etc.

def register_member(members):
    name = input("Enter new member's full name: ").strip()
    while not name:
        print("Name cannot be empty.")
        name = input("Enter new member's full name: ").strip()
    next_num = len(members) + 1
    member_id = f"M{next_num:03d}"
    while member_id in members:
        next_num += 1
        member_id = f"M{next_num:03d}"

    members[member_id] = {"name": name, "points": 0}
    print(f"Registered {name} with Member ID: {member_id} (0 points).")
    return members

# Adds 1 point per $100 spent to a loyalty member.
def award_points(members, member_id, amount_spent):
    member_id = member_id.upper()
    if member_id not in members:
        return 0
    earned = int(amount_spent // 100)
    members[member_id]["points"] += earned
    return earned

 # Deducts 50 points and adds one free Regular Coffee (price $0) if eligible.
  # Track free coffee using a special key or flag in order

def redeem_points(members, member_id, order):
    member_id = member_id.upper()
    if member_id in members and members[member_id]["points"] >= 50:
        members[member_id]["points"] -= 50
        order["FREE_C01"] = order.get("FREE_C01", 0) + 1
        return True
    return False

 #  Appends a completed order with date and time to the orders file.
def save_order(filename, order, totals):
    timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    subtotal, discount, tax, total = totals
    items_str = ";".join(f"{code}:{qty}" for code, qty in order.items())

    try:
        with open(filename, "a", encoding="utf-8") as file:
            file.write(f"{timestamp}|{items_str}|{subtotal:.2f}|{discount:.2f}|{tax:.2f}|{total:.2f}\n")
    except OSError:
        print("Error: Could not save order record.")


#     Helper function to read saved orders from the orders file safely.
def load_orders(filename):
    
    orders = []
    if not os.path.exists(filename):
        return orders

    try:
        with open(filename, "r", encoding="utf-8") as file:
            for line in file:
                line = line.strip()
                if not line:
                    continue
                parts = line.split("|")
                if len(parts) != 6:
                    continue
                items_dict = {}
                for pair in parts[1].split(";"):
                    if ":" in pair:
                        code, qty = pair.split(":")
                        items_dict[code] = int(qty)
                orders.append({
                    "timestamp": parts[0],
                    "items": items_dict,
                    "subtotal": float(parts[2]),
                    "discount": float(parts[3]),
                    "tax": float(parts[4]),
                    "total": float(parts[5])
                })
    except (OSError, ValueError):
        print("Warning: Error reading orders file.")
    return orders

# Generates a summary report dictionary from completed orders.
def generate_daily_report(orders, menu):
    order_count = len(orders)
    total_revenue = 0.0
    total_tax = 0.0
    item_counts = {}

    for ord_data in orders:
        total_revenue += ord_data["total"]
        total_tax += ord_data["tax"]
        for code, qty in ord_data["items"].items():
            clean_code = code.replace("FREE_", "")
            item_counts[clean_code] = item_counts.get(clean_code, 0) + qty

    best_item = "None"
    if item_counts:
        best_code = max(item_counts, key=item_counts.get)
        best_name = menu[best_code][0] if best_code in menu else best_code
        best_item = f"{best_name} ({item_counts[best_code]} sold)"

    return {
        "order_count": order_count,
        "total_revenue": total_revenue,
        "total_tax": total_tax,
        "best_selling_item": best_item
    }

# Prints the daily sales report in a clear layout.
def display_report(report): 
    print("\n" + "=" * 48)
    print(f"{'DAILY SALES SUMMARY REPORT':^48}")
    print("=" * 48)
    print(f"{'Total Orders:':<25} {report['order_count']}")
