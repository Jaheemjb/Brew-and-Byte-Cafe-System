# MAIN PROGRAM LOOP
# ==========================================

# Runs the main application loop for the Brew & Byte Café Ordering System.
def main():
    menu = load_menu(MENU_FILE)
    members = load_loyalty(LOYALTY_FILE)
    order = {}

    while True:
        display_main_menu(order, menu)
        choice = get_menu_choice(0, 8)

        if choice == 1:
            display_menu(menu)

        elif choice == 2:
            display_menu(menu)
            code = get_valid_code("Enter item code: ", menu)
            quantity = get_valid_quantity("Enter quantity (1-20): ")
            add_item(order, menu, code, quantity)
            print(f"Added {quantity} x {menu[code][0]} to the order.")

        elif choice == 3:
            if not order:
                print("\nYour order is empty. Nothing to remove.")
            else:
                view_order(order, menu)
                code = input("Enter item code to remove: ").strip().upper()
                if remove_item(order, code):
                    print(f"Removed {code} from the order.")
                else:
                    print("Item code not found in your current order.")

        elif choice == 4:
            view_order(order, menu)

        elif choice == 5:
            if not order:
                print("\nYour order is empty. Nothing to update.")
            else:
                view_order(order, menu)
                code = input("Enter item code to update: ").strip().upper()
                if code in order:
                    new_qty = get_valid_quantity("Enter new quantity (1-20): ")
                    order[code] = new_qty
                    print(f"Updated {menu[code][0]} quantity to {new_qty}.")
                else:
                    print("Item code not found in your current order.")

        elif choice == 6:
            handle_checkout(order, menu, members)

        elif choice == 7:
            if not order:
                print("\nOrder is already empty.")
            elif get_yes_no("Are you sure you want to cancel the current order? (y/n): "):
                order.clear()
                print("Order cancelled.")

        elif choice == 8:
            handle_manager_menu(members, menu)

        elif choice == 0:
            print("Thank you for using Brew & Byte Café Ordering System. Goodbye!")
            break


if __name__ == "__main__":
    main()
